# Указываем базовый образ
FROM node:20-alpine
# Настраиваем рабочую директорию внутри контейнера
WORKDIR /app
# Сначала копируем файлы зависимостей (для эффективного кэширования слоев Docker)
COPY package*.json ./
# Устанавливаем только production-зависимости
RUN npm ci --only=production
# Копируем остальной исходный код приложения
COPY . .
# Открываем порт, который использует Express приложение
EXPOSE 3000
# Команда для запуска веб-сервера
CMD ["npm", "start"]
